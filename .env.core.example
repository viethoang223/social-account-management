# Core server — copy to .env.core (or run: node scripts/gen-secrets.mjs, which fills the secrets).
# Used by: docker compose -f infra/compose/core.yml --env-file .env.core up -d
# Holds the ONLY copy of the LLM key, storage keys and API tokens. Never put these on worker hosts.

# ── compose variables ──
DOMAIN=ops.example.com                 # public hostname for the ops web (DNS A record → this server)
POSTGRES_PASSWORD=__GENERATE__
WG_BIND_IP=10.88.0.1                   # WireGuard address of this server; Postgres listens only here
SEEDINGSYS_VERSION=0.1.0

# ── app ──
# pilot-test = fb-web connector with audience "Chỉ mình tôi"; pilot-live = real audience.
# (The fb-web connector is NOT released yet: until it is, nothing can be published to real accounts.)
APP_ENV=pilot-test
REEL_ALLOW_UNVERIFIED_AUDIENCE=false
TZ_OPERATIONS=Asia/Ho_Chi_Minh
LOG_LEVEL=info
WORKER_NAME=core-1

# ── LLM ──
LLM_MODE=claude
ANTHROPIC_API_KEY=
LLM_EDITOR_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_DAILY_BUDGET_USD=20
LLM_MAX_CONCURRENCY=3

# ── object storage (Cloudflare R2, private bucket) ──
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seedingsys-media

# ── ops access: token → role. Roles: admin | reviewer | operator | viewer ──
API_TOKENS='{"__ADMIN__":"admin","__REVIEWER__":"reviewer","__OPERATOR__":"operator","__VIEWER__":"viewer"}'

# SENTRY_DSN=

# ── fb-web connector (browser automation of the target accounts) ──
# Formats allowed to publish. EMPTY = nothing is published to Facebook. Add a format only after
# `pnpm fb:capability` passed for it on the real UI (Chỉ mình tôi).
FB_ENABLED_FORMATS=
FB_PROFILES_DIR=/profiles                  # one persistent browser profile per target; encrypted disk
FB_HEADLESS=true
# FB_BROWSER_CHANNEL=msedge                 # use an installed Edge/Chrome instead of bundled Chromium
# FB_SCREENSHOT_DIR=/var/seedingsys/shots   # failure screenshots (may show personal data; short retention)
# After posting: caption (default) | strict | off (no check at all)
FB_VERIFY=caption
