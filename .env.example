# ── core ──
# local | pilot-test | pilot-live
APP_ENV=local
DATABASE_URL=postgresql://seedingsys:seedingsys@127.0.0.1:54329/seedingsys
WORKER_NAME=local-1
TZ_OPERATIONS=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# ── LLM gateway (core server only — never on worker hosts) ──
# fake | claude
LLM_MODE=fake
# ANTHROPIC_API_KEY=               # or ANTHROPIC_AUTH_TOKEN / `ant auth login` profile
LLM_EDITOR_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_DAILY_BUDGET_USD=20
LLM_MAX_CONCURRENCY=3

# ── object storage ──
# local | r2
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/objects
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=seedingsys-media

# ── host limits (spec §16) ──
BROWSER_MAX_SESSIONS=4
COLLECTOR_CONCURRENCY=2
PUBLISHER_CONCURRENCY=2
# Allow a Public Reel to use the account default when Facebook omits the audience label.
REEL_ALLOW_UNVERIFIED_AUDIENCE=false
VIDEO_CONCURRENCY=1

# ── API ──
API_PORT=3001
API_TOKENS='{"dev-admin-token":"admin","dev-reviewer-token":"reviewer","dev-operator-token":"operator"}'

# SENTRY_DSN=
FAKE_PLATFORM_FILE=.data/fake-platform.json

# ── fb-web connector (only when a target uses connector fb-web; see docs/FB-WEB.md) ──
# FB_ENABLED_FORMATS=            # empty = nothing is published to Facebook
# FB_PROFILES_DIR=C:/seedingsys-profiles
# FB_HEADLESS=true
# FB_BROWSER_CHANNEL=msedge
