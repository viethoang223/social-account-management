{
  "manifest_version": 3,
  "name": "SeedingSys Profile Connector",
  "version": "1.2.45",
  "minimum_chrome_version": "120",
  "description": "Connects one signed-in Facebook profile to its SeedingSys target.",
  "permissions": ["alarms", "cookies", "scripting", "storage"],
  "host_permissions": ["https://www.facebook.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html" }
}
