# Worker host — copy to .env.worker. Used by: docker compose -f infra/compose/worker.yml --env-file .env.worker up -d
# Must NOT contain ANTHROPIC_API_KEY or API_TOKENS.

# Use a restricted DB role created for this host; reach Postgres over WireGuard (10.88.0.1).
DATABASE_URL=postgresql://worker_1:CHANGE_ME@10.88.0.1:5432/seedingsys
WORKER_NAME=worker-1
APP_ENV=pilot-test
TZ_OPERATIONS=Asia/Ho_Chi_Minh
LOG_LEVEL=info
SEEDINGSYS_VERSION=0.1.0
PROFILES_DIR=/srv/seedingsys/profiles   # encrypted disk; never synced to cloud backup

# Host limits (spec §16)
BROWSER_MAX_SESSIONS=4
COLLECTOR_CONCURRENCY=2
PUBLISHER_CONCURRENCY=2
VIDEO_CONCURRENCY=1

# Optional executable for higher-resolution public Instagram Reel renditions.
# MEDIA_YTDLP_PATH=/usr/local/bin/yt-dlp

# Media storage (same private bucket as core)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=seedingsys-media

# ── fb-web connector (browser automation of the target accounts) ──
# Formats allowed to publish. EMPTY = nothing is published to Facebook.
# Optional selector tests: pnpm fb:capability (Chỉ mình tôi).
FB_ENABLED_FORMATS=
FB_PROFILES_DIR=/profiles                  # one persistent browser profile per target; encrypted disk
FB_HEADLESS=true
# FB_BROWSER_CHANNEL=msedge                 # use an installed Edge/Chrome instead of bundled Chromium
# FB_SCREENSHOT_DIR=/var/seedingsys/shots   # failure screenshots (may show personal data; short retention)
# After posting: caption (default) | strict | off (no check at all)
FB_VERIFY=caption
