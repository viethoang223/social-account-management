{
  "name": "seedingsys",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "db:local": "tsx scripts/local-db.ts",
    "db:generate": "pnpm --filter @seedingsys/db exec prisma generate",
    "db:migrate": "pnpm --filter @seedingsys/db exec prisma migrate deploy",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "dev:api": "tsx watch --env-file=.env apps/api/src/main.ts",
    "dev:core": "tsx watch --env-file=.env apps/worker-core/src/main.ts",
    "dev:browser": "tsx watch --env-file=.env apps/worker-browser/src/main.ts",
    "dev:media": "tsx watch --env-file=.env apps/worker-media/src/main.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @seedingsys/web typecheck",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:e2e": "vitest run tests",
    "fake": "tsx --env-file=.env scripts/fake.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:web": "pnpm --filter @seedingsys/web dev",
    "build:web": "pnpm --filter @seedingsys/web build",
    "start:web": "pnpm --filter @seedingsys/web start",
    "server:start": "node scripts/server.mjs start",
    "server:stop": "node scripts/server.mjs stop",
    "server:status": "node scripts/server.mjs status",
    "move": "node scripts/move-machine.mjs",
    "fb:login": "tsx --env-file=.env scripts/fb-login.ts",
    "fb:capability": "tsx --env-file=.env scripts/fb-capability.ts",
    "check:storage": "tsx --env-file=.env scripts/check-storage.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8",
    "@seedingsys/config": "workspace:*",
    "@seedingsys/contracts": "workspace:*",
    "@seedingsys/db": "workspace:*",
    "@seedingsys/domain": "workspace:*",
    "@seedingsys/queue": "workspace:*",
    "@seedingsys/llm": "workspace:*",
    "@seedingsys/storage": "workspace:*",
    "@seedingsys/observability": "workspace:*",
    "@seedingsys/connectors-core": "workspace:*",
    "@seedingsys/connectors-fake": "workspace:*",
    "@seedingsys/worker-core": "workspace:*",
    "@seedingsys/worker-browser": "workspace:*",
    "@seedingsys/worker-media": "workspace:*",
    "@seedingsys/connectors-fb-web": "workspace:*",
    "@seedingsys/connectors-manual": "workspace:*",
    "@aws-sdk/client-s3": "^3.700.0",
    "@seedingsys/connectors-fb-graph": "workspace:*"
  }
}
